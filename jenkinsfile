pipeline{
    agent any
    parameters{
        string(
            name:'Git_BranchName',
            defaultValue:'develop',
            description:'Dynamic_Branch switching'
        )
    }
    stages{
        stage('Git_Repo_Checkout'){
            steps{

                git branch: "${params.develop}", url: 'https://github.com/PRDevopsProjects/Jenkinsparameters.git'

            }
        }

        stage('Proj_Config'){
            steps{
                echo "Git Branch_Name:${params.develop}",
                sh  'whoami'
                sh 'pwd'
            }
        }
    }
}